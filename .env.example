# ClickHouse (READ-ONLY user recommended) -- the canonical offer/FAQ source
# for the ingestion pipeline (python ingestion/refresh.py). The chatbot itself
# never connects to ClickHouse unless PERSONAL_QUERIES_ENABLED / CATALOG_QUERIES_ENABLED
# are on; the fetch scripts are the only consumers of CLICKHOUSE_* for the index.
CLICKHOUSE_HOST=clickhouse-test.waffarha.tech
CLICKHOUSE_PORT=443
CLICKHOUSE_SECURE=true
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=
# Live customer-service phase uses main_eg (see data/database-sctructure-main-eg.csv).
# Legacy installs used `main`. All SQL goes through config.ch_table(), so this
# is a pure .env switch with zero code changes.
CLICKHOUSE_DATABASE=main_eg

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_NUM_CTX=1536

# Optional -- free cloud generation backend (branch exp/free-cloud-llm).
# LLM_PROVIDER=ollama (default, local) or gemini (free tier, needs key below).
# One switch flips every LLM call (answers, agent planner, intent judge);
# embeddings/retrieval stay local either way. See docs/CLOUD_LLM.md.
# LLM_PROVIDER=gemini
# Get a free key at https://aistudio.google.com/apikey -- never commit it
# (.env is gitignored).
# GEMINI_API_KEY=
# Free-tier-friendly default; flash-lite is faster for big eval sweeps.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT=60

# Optional -- pollinations.ai anonymous tier: free, NO signup, NO key.
# LLM_PROVIDER=pollinations to route everything there, or leave it for the
# compare script (eval/compare_local_vs_cloud.py), which uses it automatically.
# Only "openai" style aliases work anonymously; check
# https://text.pollinations.ai/models for the current roster.
# POLLINATIONS_MODEL=openai
# POLLINATIONS_TIMEOUT=90

# sentence-transformers device: "cpu" (default) or "cuda" if you have an
# NVIDIA GPU + the matching faiss-gpu / torch CUDA build installed.
EMBEDDING_DEVICE=cpu

# Optional -- override the embedding model.
# Can be a sentence-transformers model id (e.g. BAAI/bge-m3,
# sentence-transformers/paraphrase-multilingual-mpnet-base-v2) OR a
# provider-prefixed id:
#   ollama:qwen3-embedding:0.6b           (served via OLLAMA_HOST)
#   jina:jina-embeddings-v5-text-small    (hosted API, needs JINA_API_KEY)
# Must match whatever data/index/<model>/<backend>/ was actually built with,
# or RagEngine will raise "Index not found". Prebuilt indexes in this repo
# exist for BAAI/bge-m3 (faiss + qdrant) and
# sentence-transformers/paraphrase-multilingual-mpnet-base-v2 (faiss).
EMBEDDING_MODEL=BAAI/bge-m3

# Optional -- which vector store backend to read the prebuilt index from.
# Must match the backend the index was built with. Defaults to "qdrant"
# (embedded, folder mode); "faiss" and "chroma" are also available.
# VECTOR_STORE_BACKEND=qdrant

# Optional -- API key for the Jina AI hosted embeddings API, only used when
# EMBEDDING_MODEL (or --embedding-model) starts with "jina:". Get one at https://jina.ai.
JINA_API_KEY=

# Optional -- how many chat requests Ollama (and the app) will generate for
# at once. Raise together with your host's CPU/RAM headroom -- each slot
# roughly multiplies the loaded model's memory use. Requests beyond this
# queue for GENERATION_QUEUE_TIMEOUT seconds, then get a 503 + Retry-After.
OLLAMA_NUM_PARALLEL=4
GENERATION_QUEUE_TIMEOUT=30


# Optional -- session memory backend (memory.py). docker-compose.yml
# already points this at the redis service automatically; only set it here
# if you're running app.py directly (not via Docker) against your own
# Redis instance.
# REDIS_URL=redis://localhost:6379/0
MEMORY_BACKEND=local

# Per-user ("my coupons / my orders") live ClickHouse queries. These are
# gated behind identity resolution (see IDENTITY_BACKEND below) and MUST stay
# off until a REAL identity backend is configured -- never run personal
# queries against a demo/static identity in production, or users will see
# each other's coupon data.
PERSONAL_QUERIES_ENABLED=false

# Who supplies the trusted user_id for personal queries:
#   static  -- fixed test user (LOCAL DEV/DEMO ONLY)
#   header  -- X-User-ID header set by an auth proxy (only if this service is
#              never exposed directly to clients)
#   session -- session cookie/bearer resolved against a shared Redis session store
#   auth    -- PRODUCTION-SAFE: verifies X-User-ID + X-User-Auth headers signed
#              with HMAC-SHA256 over "<user_id>:<expiry>" using AUTH_SIGNING_SECRET.
#              Generate one:  python -c "import secrets;print(secrets.token_hex(32))"
IDENTITY_BACKEND=static
STATIC_TEST_USER_ID=55

# Only used when IDENTITY_BACKEND=auth. Leave unset => personal queries are
# refused (fail-closed). The auth layer that validated the user's session
# must inject the signed headers below before forwarding requests here.
# AUTH_SIGNING_SECRET=
# AUTH_SIGNATURE_HEADER=X-User-Auth
# AUTH_CLOCK_SKEW_SECONDS=300


CATALOG_QUERIES_ENABLED=false

# Unified customer-service lookups (vouchers, refunds, bill/medical/trip/gift
# orders, order problems) in support/support_queries.py + agent support_lookup
# tool. Public parts need no auth; per-user parts reuse the PERSONAL gate.
SUPPORT_QUERIES_ENABLED=true
SUPPORT_ORDER_LIMIT=5

# Voice agent (STT mic input + TTS spoken replies, Chatterbox-EG default).
# The chatbot holds no audio models: /api/voice/* proxies the voice lab
# service (eval/voice_eval/lab.py, default http://127.0.0.1:8002), which
# owns model loading/VRAM. Keep off unless the lab is running.
# VOICE_ENABLED=true
# VOICE_LAB_URL=http://127.0.0.1:8002
# VOICE_STT_MODEL=fw-small        # fast; or whisper-ar-dialect for EG accuracy
# VOICE_TTS_MODEL=chatterbox-eg   # tested EG winner; or nabra-82m (fast MSA)
# VOICE_TIMEOUT=600
# VOICE_TTS_MAX_CHARS=350

# Public hosting (VM): canonical URL + extra CORS origins.
# Set both before exposing to the internet. The widget is same-origin
# (served by the app itself), so browsers only need CORS when a different
# site calls your API.
# PUBLIC_URL=https://chat.waffarha.com
# ALLOWED_ORIGINS=https://chat.waffarha.com,https://waffarha.com

# Optional -- minimum "raw" embedding similarity a candidate needs before the
# FAQ/offer/stock direct-answer shortcuts may fire. These shortcuts are gated on
# DIRECT_ANSWER_SCORE, but that figure includes lexical/intent/entity bonuses and
# can be inflated past the threshold by mediocre candidates (combined_score with
# 0.5-1.6+ of bonuses while the embedding score is < 0.6). This floor keeps the
# shortcut from overriding the normal retrieval pipeline on weak matches.
# Default 0.55; every FAQ direct answer that fired in the phase-3 baseline had
# embedding score >= 0.587, so the default blocks no genuine cases.
DIRECT_ANSWER_MIN_EMBEDDING_SCORE=0.55
