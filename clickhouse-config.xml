<clickhouse>
    <!-- Allow default user to connect without password from anywhere -->
    <users>
        <default>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>
    </users>

    <!-- Listen on all interfaces for HTTP and native protocols -->
    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>

    <!-- Allow unlimited memory for local dev -->
    <max_memory_usage>10000000000</max_memory_usage>
    <max_memory_usage_for_user>10000000000</max_memory_usage_for_user>

    <!-- Logger for debugging -->
    <logger>
        <level>information</level>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>1000M</size>
        <count>10</count>
    </logger>
</clickhouse>